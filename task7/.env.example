APP_NAME=AI记事本
DATABASE_URL=sqlite:///./ai_notebook.db

# 官方 Anthropic 默认配置
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_EFFORT=medium

# 如果使用 Anthropic-compatible 代理或 Claude Code 同款环境变量，可改成：
# ANTHROPIC_AUTH_TOKEN=your-token
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
# ANTHROPIC_DEFAULT_OPUS_MODEL=openai/gpt-5.5
# API_TIMEOUT_MS=600000
# 对非 claude-* 模型，默认不发送 thinking/output_config 等 Claude 专用参数。
# 如代理支持这些参数，可设为 true。
# ANTHROPIC_ENABLE_CLAUDE_PARAMS=false

REMINDER_POLL_SECONDS=10
